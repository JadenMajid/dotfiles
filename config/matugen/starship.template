# Starship Configuration Generated by Matugen
format = "$all"

[character]
success_symbol = "[➜](bold #{{colors.primary.default.hex_stripped}})"
error_symbol = "[➜](bold #{{colors.error.default.hex_stripped}})"

[directory]
truncation_length = 3
truncation_symbol = "…/"
style = "bold #{{colors.primary.default.hex_stripped}}"

[git_branch]
symbol = " "
style = "bold #{{colors.secondary.default.hex_stripped}}"

[git_status]
format = '([\[$all_status$ahead_behind\]]($style) )'
style = "bold #{{colors.tertiary.default.hex_stripped}}"

[package]
symbol = "󰏗 "

[python]
symbol = " "

[rust]
symbol = " "
